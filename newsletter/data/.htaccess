# Datenverzeichnis: Datenbank, Sperrdateien, Testpostausgang.
# Von außen darf hier nichts erreichbar sein.

Require all denied

<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>

# Zur Sicherheit zusätzlich: PHP hier nie ausführen
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
